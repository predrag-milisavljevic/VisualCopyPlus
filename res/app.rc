#include <windows.h>
#include <commctrl.h>
#include "resource.h"

IDI_APP ICON "app.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "VisualCopy+"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "VisualCopyPlus"
            VALUE "OriginalFilename", "VisualCopyPlus.exe"
            VALUE "ProductName", "VisualCopy+"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDD_SETTINGS DIALOGEX 0, 0, 300, 334
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "VisualCopy+ Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Window flash", IDC_STATIC, 7, 6, 286, 92
    AUTOCHECKBOX    "Flash the window you copied from", IDC_FLASH_ENABLE, 15, 19, 180, 10
    LTEXT           "Style:", IDC_STATIC, 15, 37, 38, 8
    COMBOBOX        IDC_FLASH_STYLE, 56, 35, 90, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Duration:", IDC_STATIC, 160, 37, 36, 8
    COMBOBOX        IDC_FLASH_DURATION, 200, 35, 84, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Color:", IDC_STATIC, 15, 56, 38, 8
    AUTORADIOBUTTON "Accent", IDC_COLOR_ACCENT, 56, 55, 42, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Custom", IDC_COLOR_CUSTOM, 100, 55, 40, 10
    PUSHBUTTON      "", IDC_COLOR_SWATCH, 142, 52, 30, 15, BS_OWNERDRAW | WS_GROUP | WS_TABSTOP
    AUTOCHECKBOX    "Animate (fade in/out)", IDC_FLASH_ANIMATE, 200, 55, 88, 10, WS_TABSTOP
    LTEXT           "Opacity:", IDC_STATIC, 15, 77, 38, 8
    CONTROL         "", IDC_OPACITY, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | TBS_BOTH | WS_TABSTOP, 52, 73, 200, 16
    RTEXT           "70%", IDC_OPACITY_LABEL, 254, 77, 30, 8

    GROUPBOX        "Toast", IDC_STATIC, 7, 104, 286, 46
    AUTOCHECKBOX    "Show a toast with what was copied", IDC_TOAST_ENABLE, 15, 117, 160, 10
    AUTOCHECKBOX    "Include content preview (text, thumbnail, file names)", IDC_TOAST_PREVIEW, 15, 132, 190, 10
    LTEXT           "Show for:", IDC_STATIC, 196, 118, 34, 8
    COMBOBOX        IDC_TOAST_DURATION, 232, 116, 52, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    GROUPBOX        "Sound", IDC_STATIC, 7, 156, 286, 34
    AUTOCHECKBOX    "Play a sound", IDC_SOUND_ENABLE, 15, 171, 60, 10
    COMBOBOX        IDC_SOUND_KIND, 78, 169, 114, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Browse...", IDC_SOUND_BROWSE, 196, 168, 44, 14
    PUSHBUTTON      "Play", IDC_SOUND_PLAY, 244, 168, 40, 14

    GROUPBOX        "Ignored apps (matched by the clipboard owner's process)", IDC_STATIC, 7, 196, 286, 106
    LISTBOX         IDC_IGNORE_LIST, 15, 209, 180, 72, LBS_NOTIFY | LBS_SORT | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    PUSHBUTTON      "Remove", IDC_IGNORE_REMOVE, 200, 209, 84, 14
    PUSHBUTTON      "Browse for .exe...", IDC_IGNORE_BROWSE, 200, 227, 84, 14
    PUSHBUTTON      "Ignore last source", IDC_IGNORE_LAST, 200, 245, 84, 14
    EDITTEXT        IDC_IGNORE_EDIT, 15, 284, 180, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "Add", IDC_IGNORE_ADD, 200, 283, 84, 14

    AUTOCHECKBOX    "Start with Windows", IDC_AUTOSTART, 12, 314, 100, 10
    PUSHBUTTON      "Test", IDC_TEST, 186, 311, 50, 15
    PUSHBUTTON      "Close", IDCANCEL, 240, 311, 50, 15
END
